package HealthSystem {

    import UniversitySystem

    mixin LivingBeing {
        name: string
        birthDate: date
    }

    kind Patient {
        medicalRecordNumber: string
        email: string
    }

    kind Doctor {
        crm: string
        specialty: string
    }

    quantity Dose {
        amount: number
    }

    material MedicalConsultation {
        patient: Patient [1..1]
        doctor: Doctor [1..*]
    }

    PhoneDataType
    AddressDataType

    genset Doctor: GeneralPractician Surgeon

}