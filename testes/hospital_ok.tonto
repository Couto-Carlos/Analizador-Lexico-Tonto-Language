import Farmacia
import Laboratorio

package Hospital

datatype Endereco {
    rua : string
    number : int
    cidade : string
}

datatype Medicao {
    valor : number
    unidade : string
    confirmada : boolean
}

enum Especialidade {
    Clinico_Geral01,
    Pediatra02,
    Ginecologista03,
    Dentista04
}

enum TipoSanguineo {
    A_Plus01,
    A_Minus02,
    B_Plus03,
    B_Minus04,
    AB_Plus05,
    AB_Minus06,
    O_Plus07,
    O_Minus08
}

enum Tipo_De_Consulta {
    Acompanhamento_Pediatrico01,
    Atendimento_Pre_Natal02,
    Atendimento_Odontologico03,
    Consulta_Clinica_Geral04
}

enum Tipo_De_Vacina {
    Covid01,
    FebreAmarela02,
    Tetano03,
    Influenza04
}

kind Pessoa of functional-complexes {
    nome : string [1]
    cpf : string [1]
    data_nascimento : date [1] {const}
    telefones : string [0..*] {ordered}
    idade : number [0..1] {derived}
    endereco : Endereco
}

phase Crianca specializes Pessoa
phase Adolescente specializes Pessoa
phase Adulto specializes Pessoa
phase Idoso specializes Pessoa

role Funcionario specializes Pessoa
role Enfermeiro specializes Funcionario
role Medico specializes Funcionario {
    especialidade : Especialidade
}

roleMixin Cliente_Do_Servico

role Paciente specializes Pessoa, Cliente_Do_Servico {
    tipo_sanguineo : TipoSanguineo
    numero_prontuario : number
    internado : boolean
}

kind Unidade_Basica_De_Saude {
    nome : string [1]
    @componentOf [1] <>-- [1..*] Departamento
}

kind Departamento {
    nome : string
    @componentOf [1..*] --<> [1] Unidade_Basica_De_Saude
}

collective Equipe_Medica {
    @memberOf [1] <>-- [2..*] Medico
}

category Recurso_Hospitalar
mixin Material_Clinico

kind Vacina {
    tipo_de_vacina : Tipo_De_Vacina
    validade : date
}

subkind Vacina_Viral specializes Vacina

mode Sintoma {
    descricao : string
    inicio : datetime
    horario_medicao : time
}

quality Nivel_De_Risco {
    medida : Medicao
}

quantity Dose_Aplicada

event Consulta_Realizada
situation Exposicao_Ao_Alergeno

relator Consulta_Medica {
    tipo_de_consulta : Tipo_De_Consulta
    realizada_em : datetime

    @mediation [1..*] -- [1] Paciente
    @mediation [1..*] -- [1] Medico
}

relator Vacinacao {
    @mediation -- envolveEnfermeiro -- [1] Enfermeiro
    -- envolvePaciente -- [1] Paciente
    @mediation -- envolveVacina -- [1..*] Vacina
}

@material relation Paciente [1..*] -- consultado_Por -- [1..*] Medico
@material relation Paciente [1..*] -- atendido_Em -- [1..*] Unidade_Basica_De_Saude
@material relation Enfermeiro [1..*] -- verifica -- [1..*] Vacina
@mediation relation Consulta_Medica [1..*] -- [1] Paciente
relation Paciente [1] -- [0..*] Sintoma
@componentOf relation Unidade_Basica_De_Saude [1] <>-- [1..*] Departamento

disjoint complete genset FaixaEtaria {
    general Pessoa
    specifics Crianca, Adolescente, Adulto, Idoso
}

disjoint complete genset PapeisNaUBS where Medico, Enfermeiro specializes Funcionario

overlapping incomplete genset PapeisDePessoa {
    general Pessoa
    specifics Paciente, Funcionario
}

genset TiposDeVacina where Vacina_Viral specializes Vacina
